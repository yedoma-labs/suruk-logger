{
  "name": "@yedoma-labs/suruk-logger",
  "version": "0.3.1",
  "description": "Winston-compatible Pino wrapper with request context binding",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "keywords": [
    "logger",
    "logging",
    "pino",
    "winston",
    "structured-logging",
    "request-context",
    "typescript"
  ],
  "author": "Yedoma Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yedoma-labs/suruk-logger.git"
  },
  "peerDependencies": {
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/language-core": "^3.3.12",
    "esbuild": "^0.28.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "semantic-release": "^25.0.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
