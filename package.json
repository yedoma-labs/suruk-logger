{
  "name": "@yedoma-labs/suruk-logger",
  "version": "0.2.0",
  "description": "Winston-compatible Pino wrapper with request context binding",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-push": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "logger",
    "logging",
    "pino",
    "winston",
    "structured-logging",
    "request-context",
    "typescript"
  ],
  "author": "Yedoma Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yedoma-labs/suruk-logger.git"
  },
  "peerDependencies": {
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/language-core": "^3.3.5",
    "esbuild": "^0.28.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  }
}
