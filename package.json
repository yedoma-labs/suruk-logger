{
  "name": "@yedoma-labs/suruk-logger",
  "version": "0.1.0",
  "description": "Winston-compatible Pino wrapper with request context binding",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "logger",
    "logging",
    "pino",
    "winston",
    "structured-logging",
    "request-context",
    "typescript"
  ],
  "author": "Yedoma Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yedoma-labs/suruk-logger.git"
  },
  "dependencies": {},
  "peerDependencies": {
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^4.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.8"
  }
}
